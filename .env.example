APP_NAME="Usayd Academy API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=usayd_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Private S3: explicitly configure a dedicated non-public bucket.
# Prefer AWS workload identity / IAM roles; do not commit access keys.
AWS_PRIVATE_BUCKET=
AWS_DEFAULT_REGION=us-east-1
AWS_PRIVATE_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=usayd_cache_

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@usayd.academy"
MAIL_FROM_NAME="${APP_NAME}"
